{
  "name": "@codeskop/tracker-react",
  "version": "1.0.0",
  "description": "First-class React integration for @codeskop/tracker — a provider, an error boundary, and a hook.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "size": "size-limit",
    "api:check": "api-extractor run --verbose",
    "api:update": "api-extractor run --local --verbose"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "2.5 KB",
      "gzip": true,
      "ignore": ["react", "@codeskop/tracker"]
    }
  ],
  "dependencies": {
    "@codeskop/tracker": "^1.0.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.58.9",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "size-limit": "^12.1.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
